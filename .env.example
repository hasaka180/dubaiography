# Copy to .env.local for local dev, and set these in Vercel → Project → Settings → Environment Variables.
# With NONE of these set, the site still runs: content falls back to data/articles.json
# and the studio is open locally (but disabled in production).

# Password that gates /studio and the write/upload APIs.
# If unset locally the gate is skipped. In production it is REQUIRED (studio is disabled without it).
STUDIO_PASSWORD=

# ── Cloudflare R2 (articles + media uploads) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public media bucket, organised into articles/ covers/ misc/ folders.
R2_BUCKET=
# The media bucket's public URL, e.g. https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_BASE_URL=
# Private bucket for the article JSON (content/articles.json). Falls back to
# R2_BUCKET if unset - but then drafts are readable at the public r2.dev URL.
R2_CONTENT_BUCKET=

# ── Appwrite (old article storage) ──
# Only read by scripts/migrate-appwrite-to-r2.mjs. Delete once you've migrated.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_COLLECTION_ID=

# ── SEO ──
# Your production URL (used for sitemap, robots, canonical/OG).
NEXT_PUBLIC_SITE_URL=https://dubaiography.com
# Google Search Console HTML-tag verification token (the content="..." value).
GOOGLE_SITE_VERIFICATION=
